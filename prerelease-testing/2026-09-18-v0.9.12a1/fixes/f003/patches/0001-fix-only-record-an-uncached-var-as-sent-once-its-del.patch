+
+    class AsyncWithheldState(BaseState):
+        n: int = 0
+
+        @rx.var(cache=False)
+        async def secret(self) -> str:
+            return f"secret-{self.n}"
+
+    state_cls = AsyncWithheldState if is_async else WithheldState
