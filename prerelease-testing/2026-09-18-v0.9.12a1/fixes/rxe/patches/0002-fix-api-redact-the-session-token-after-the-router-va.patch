 _ROUTER_SESSION_SECRETS = ("client_token", "session_id")
 
 
+def _redact_session_value(session: Any) -> Any:
+    """Return ``session`` with its ``client_token`` / ``session_id`` blanked.
+
+    Handles both shapes session data takes in a resolved state dict: a plain
+    ``dict`` (already-serialized), or a ``SessionData`` dataclass, possibly
+    wrapped in reflex's immutable proxy. Unknown shapes are returned unchanged.
+
+    Args:
+        session: The session data to redact.
+
+    Returns:
+        A redacted copy (or the original when there is nothing to redact).
+    """
+    if isinstance(session, dict):
+        blanks = {f: "" for f in _ROUTER_SESSION_SECRETS if f in session}
+        return {**session, **blanks} if blanks else session
+    unwrapped: Any = getattr(session, "__wrapped__", session)
+    if dataclasses.is_dataclass(unwrapped) and not isinstance(unwrapped, type):
+        names = {f.name for f in dataclasses.fields(unwrapped)}
+        blanks = {f: "" for f in _ROUTER_SESSION_SECRETS if f in names}
+        if blanks:
+            return dataclasses.replace(unwrapped, **blanks)
+    return session
+
