+_SESSION_TOKEN = "SECRET-CLIENT-TOKEN"
+_SESSION_ID = "SECRET-SESSION-ID"
+
+
+def _secret_paths(obj: Any, path: str = "") -> list[str]:
+    """Paths inside ``obj`` at which a session secret is still readable.
+
+    Walks dataclasses (unwrapping reflex's immutable proxies), mappings and
+    sequences, mirroring what a JSON encoder would serialise for an API caller.
+
+    Args:
+        obj: The (redacted) structure to search.
+        path: The dotted path of ``obj`` within the root structure.
+
+    Returns:
+        Every path whose string value contains a session secret.
+    """
+    import dataclasses
+
+    obj = getattr(obj, "__wrapped__", obj)
+    if dataclasses.is_dataclass(obj) and not isinstance(obj, type):
+        return [
+            hit
+            for f in dataclasses.fields(obj)
+            for hit in _secret_paths(getattr(obj, f.name), f"{path}.{f.name}")
+        ]
+    if isinstance(obj, dict):
+        return [hit for k, v in obj.items() for hit in _secret_paths(v, f"{path}.{k}")]
+    if isinstance(obj, (list, tuple)):
+        return [
+            hit for i, v in enumerate(obj) for hit in _secret_paths(v, f"{path}[{i}]")
+        ]
+    if isinstance(obj, str) and (_SESSION_TOKEN in obj or _SESSION_ID in obj):
+        return [path]
+    return []
+
+
+def _session_data() -> Any:
+    """A ``SessionData`` carrying both server-side identifiers.
+
+    Returns:
+        A SessionData with the test's sentinel token, id and client IP.
+    """
+    from reflex.istate.data import SessionData
+
+    return SessionData(
+        client_token=_SESSION_TOKEN, client_ip="1.2.3.4", session_id=_SESSION_ID
+    )
+
