+    """The ``rx_router_session`` var (reflex >= 0.9.12) is redacted."""
+    from reflex_base.constants.state import FIELD_MARKER
+
+    from reflex_enterprise.plugins.event_handler_api import redact_router_session
+
+    state = "reflex___state____state"
+    key = "rx_router_session" + FIELD_MARKER
+    out = redact_router_session({state: {key: _session_data(), "n" + FIELD_MARKER: 1}})
+
+    assert _secret_paths(out) == []
+    session = out[state][key]
+    assert session.client_token == ""
+    assert session.session_id == ""
+    # Non-secret router fields are preserved -- handlers legitimately read them.
+    assert session.client_ip == "1.2.3.4"
+    assert out[state]["n" + FIELD_MARKER] == 1
