{
  // Type-checks the javascript that runs in a browser, in place from its JSDoc:
  // nothing is emitted, and nothing here ships. The build files, which run in
  // node, are checked by tsconfig.node.json; `npm run typecheck` runs both.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    // No node types here: `process` or `Buffer` in browser code must fail.
    "types": [],
    "skipLibCheck": true,
    "paths": {
      "$/*": ["./src/*"]
    }
  },
  "include": ["src/utils", "src/components", "types"],
  // Left unchecked, each because it imports something this package cannot
  // install or does not contain:
  // - src/app: the entry points import modules compiled into each app
  //   (`$/app/root`, the embed manifest, the global stylesheet).
  // - dataeditor.js: imports a package only the data editor component installs.
  "exclude": ["src/utils/helpers/dataeditor.js"]
}
