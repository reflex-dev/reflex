{
  // Type-checks the build files at the top of `src`, which an app runs in node.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["es2023"],
    "types": ["node"]
  },
  "include": ["src/*.js"],
  // Import packages an app installs only when the React Compiler (babel) or
  // runtime SSR (express and its middleware) is on.
  "exclude": ["src/vite-plugin-react-compiler.js", "src/ssr-serve.js"]
}
