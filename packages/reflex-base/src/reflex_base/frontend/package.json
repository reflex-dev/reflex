    "./style-reset.css": "./style-reset.css",
    "./vite-plugin-safari-cachebust": "./vite-plugin-safari-cachebust.js",
    "./compress-static.js": "./compress-static.js",
    "./package.json": "./package.json"
  },
  "files": [
    "state.js",
    "runtime.js",
    "react-theme.js",
